# All values are placeholders. Never commit real keys.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/remoteprint
PUBLIC_BASE_URL=http://localhost:3000

# Epson Connect developer console (https://developer.epsonconnect.com)
EPSON_CLIENT_ID=
EPSON_CLIENT_SECRET=
EPSON_API_KEY=
EPSON_REDIRECT_URI=http://localhost:3000/api/epson/callback
# Serial of YOUR printer; OAuth tokens for any other device are refused.
EPSON_EXPECTED_SERIAL=

# Cashfree PG (sandbox unless CASHFREE_ENV=production)
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# >= 32 random chars: openssl rand -base64 48
ADMIN_SECRET=
